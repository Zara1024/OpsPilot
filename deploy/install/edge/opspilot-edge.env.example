# opspilot-edge environment file - rendered by install-edge.sh to
# /etc/opspilot-edge/opspilot-edge.env. The systemd unit reads this via
# EnvironmentFile=. The opspilot-edge binary consumes these env vars directly
# (see internal/pkg/config/config.go: OPSPILOT_EDGE_CLOUD_ADDR / _ACCESS_KEY /
# _SECRET_KEY).

OPSPILOT_EDGE_CLOUD_ADDR=__CLOUD_ADDR__
OPSPILOT_EDGE_ACCESS_KEY=__ACCESS_KEY__
OPSPILOT_EDGE_SECRET_KEY=__SECRET_KEY__
OPSPILOT_EDGE_COLLECTOR_MODE=auto
OPSPILOT_EDGE_SCRAPE_CONFIG_FILE=/etc/opspilot-edge/scrape.yaml
OPSPILOT_EDGE_COLLECTOR_INTERVAL=10s

# Optional fixed diagnostics address. Unset/blank: prefer :9101 and let the
# OS allocate a free port if occupied. Explicit addresses never fall back.
# OPSPILOT_EDGE_METRICS_ADDR=:19101

# ---- Passive network discovery --------------------------------------
# Enabled by default. Set false to stop reporting local gateway, ARP, and
# LLDP neighbors as candidates for operator-controlled SNMP verification.
OPSPILOT_NETWORK_DISCOVERY_ENABLED=true
OPSPILOT_NETWORK_DISCOVERY_INTERVAL=1m

# ---- Plugin runtime (ADR-015) ----------------------------------------
# Edge ID is needed by every plugin to inject the `edge_id` label set on
# outbound telemetry. Empty by default — plugins refuse to render config
# until operator sets this (auto-discovered ID will land here in PR-C2).
OPSPILOT_EDGE_ID=

# ---- Logs plugin (ADR-012) -------------------------------------------
# Off by default. Set ENABLED=true + ENDPOINT=https://<manager>/loki/api/v1/push
# to start shipping journald + file tail logs. AUTH_USER / AUTH_PASS
# default to the tunnel ACCESS_KEY / SECRET_KEY above (data plane and
# control plane share credentials per ADR-014 §决策第 2 条).
OPSPILOT_EDGE_PLUGIN_LOGS_ENABLED=false
OPSPILOT_EDGE_PLUGIN_LOGS_ENDPOINT=
# OPSPILOT_EDGE_PLUGIN_LOGS_AUTH_USER=  # defaults to OPSPILOT_EDGE_ACCESS_KEY
# OPSPILOT_EDGE_PLUGIN_LOGS_AUTH_PASS=  # defaults to OPSPILOT_EDGE_SECRET_KEY
# Spec is JSON; control which sources are tailed.
# OPSPILOT_EDGE_PLUGIN_LOGS_SPEC_JSON={"file_paths":["/var/log/syslog"]}
