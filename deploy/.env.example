# opspilot — local dev compose (deploy/docker-compose.yml)
#
# Copy to deploy/.env and adjust. Every value below has a sane default in the
# compose file, so the stack also boots with no .env at all — this file just
# covers the handful you'll usually want to set for local development.
#
# This is a LOCAL DEV convenience stack: no TLS, trivial DB password baked into
# the compose file. Do NOT expose it beyond localhost. For production use the
# release package under deploy/install/ instead.

# --- First admin (seeded on first boot; if empty, no admin is created) ---
OPSPILOT_ADMIN_EMAIL=admin@opspilot.local
OPSPILOT_ADMIN_PASSWORD=change-me

# --- JWT signing secret (override the insecure default) ---
OPSPILOT_JWT_SECRET=change-me-to-a-long-random-string

# --- LLM endpoint (any OpenAI-compatible API; empty key => AI chat is disabled) ---
OPSPILOT_OPENAI_API_KEY=
OPSPILOT_OPENAI_MODEL=gpt-4o
# OPSPILOT_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Kubernetes edge enrollment ---
# Public URL and tunnel address must be reachable from the target Kubernetes cluster.
OPSPILOT_PUBLIC_URL=
OPSPILOT_TUNNEL_ADDR=
# Kubernetes Event snapshot guards. Events are kept as the current troubleshooting
# cache, not an unbounded history table.
OPSPILOT_K8S_EVENT_RETENTION=24h
OPSPILOT_K8S_EVENT_MAX_PER_CLUSTER=5000
OPSPILOT_K8S_EVENT_CLEANUP_INTERVAL=1h

# --- Embedded Grafana (local dev defaults; production install generates random) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# OPSPILOT_GRAFANA_INTERNAL_URL=http://grafana:3000/grafana
# Leave empty to disable embedded Grafana token bootstrap.
# OPSPILOT_GRAFANA_BOOTSTRAP_PASSWORD=

# --- Embedding provider for knowledge base / RAG ---
OPSPILOT_EMBEDDING_PROVIDER=local
OPSPILOT_EMBEDDING_MODEL=bge-small-zh-v1.5
OPSPILOT_EMBEDDING_DIM=512
OPSPILOT_EMBEDDING_API_KEY=
OPSPILOT_EMBEDDING_BASE_URL=

# --- Embedded observability retention (test environments can lower these) ---
OPSPILOT_PROM_RETENTION_TIME=2160h
OPSPILOT_PROM_RETENTION_SIZE=20GB
OPSPILOT_LOKI_RETENTION_PERIOD=720h
OPSPILOT_TEMPO_BLOCK_RETENTION=168h

# Test-only direct apply. Enable only when Manager runs on the Compose host.
# OPSPILOT_OBSERVABILITY_COMPOSE_DIR=/absolute/path/to/opspilot
# OPSPILOT_OBSERVABILITY_ENV_FILE=/absolute/path/to/opspilot/deploy/.env
# OPSPILOT_OBSERVABILITY_COMPOSE_FILES=deploy/docker-compose.yml
# OPSPILOT_OBSERVABILITY_COMPOSE_PROJECT=opspilot
