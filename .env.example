# Database (default: MySQL)
OPSPILOT_DB_DIALECT=mysql
OPSPILOT_DB_DSN=opspilot:opspilot@tcp(127.0.0.1:3306)/opspilot?parseTime=true&charset=utf8mb4&loc=Local

# For SQLite (opt-in, suitable for single-user local dev):
# OPSPILOT_DB_DIALECT=sqlite
# OPSPILOT_DB_PATH=./data/opspilot.db

# Server ports (in-container; nginx fronts these on the host — see ADR-008)
OPSPILOT_HTTP_ADDR=:8080
OPSPILOT_METRICS_ADDR=:9100

# nginx-fronted host ports (ADR-008). 443 = HTTPS, 80 = HTTP redirect.
# Set OPSPILOT_HTTP_REDIRECT_PORT=0 to disable the 80 -> 443 redirect.
OPSPILOT_HTTP_PORT=443
OPSPILOT_HTTP_REDIRECT_PORT=80

# --- Frontier broker (upstream singchia/frontier; ADR-007) ---
# Manager dials the broker's service-bound port (40011). Inside docker
# compose use `frontier:40011`; for `make run-opspilot` against a frontier
# container exposed via the dev compose, use `localhost:40011`.
OPSPILOT_FRONTIER_ADDR=frontier:40011
OPSPILOT_FRONTIER_SERVICE_NAME=opspilot-manager

# Bootstrap admin (cloud only). Seeded on first startup if the email is
# unused. Leave both empty to start with an empty users table (nobody can
# log in until you set these and restart).
OPSPILOT_ADMIN_EMAIL=admin@opspilot.local
OPSPILOT_ADMIN_PASSWORD=change-me-on-first-login

# JWT signing
OPSPILOT_JWT_SECRET=change-me-to-a-long-random-string
OPSPILOT_JWT_ACCESS_TTL=15m
OPSPILOT_JWT_REFRESH_TTL=168h

# OpenAI
OPSPILOT_OPENAI_API_KEY=
OPSPILOT_OPENAI_MODEL=gpt-4o
OPSPILOT_OPENAI_BASE_URL=

# --- Cloud-side Prometheus (ADR-009) ---
# When OPSPILOT_PROM_ENABLED=true the manager forwards push_prom_samples to
# remote_write, and the AI agent gains a query_promql tool. Leave false
# until you actually deploy a Prom container.
OPSPILOT_PROM_ENABLED=true
OPSPILOT_PROM_URL=http://prometheus:9090/prometheus
# Optional exact remote_write endpoint for Prometheus-compatible TSDBs
# (VictoriaMetrics / Mimir / Cortex / Thanos receive). Empty means
# OPSPILOT_PROM_URL + /api/v1/write.
OPSPILOT_PROM_REMOTE_WRITE_URL=
# Optional Prometheus-compatible query API root. Empty means OPSPILOT_PROM_URL.
OPSPILOT_PROM_QUERY_URL=http://prometheus:9090/prometheus

# --- Built-in host alert thresholds (fast-path HostMetricPoint) ---
OPSPILOT_ALERT_ENABLED=true
OPSPILOT_ALERT_COOLDOWN=10m
OPSPILOT_ALERT_CPU_PERCENT=90
OPSPILOT_ALERT_MEM_PERCENT=90
OPSPILOT_ALERT_DISK_USED_PERCENT=90
# 0 disables load1 alerting; set an absolute load threshold if desired.
OPSPILOT_ALERT_LOAD1=0

# --- Outbound notifications (alerts / scheduled jobs / proactive AIOps) ---
# Disabled by default. Set default channels to any enabled channel names below.
OPSPILOT_NOTIFY_ENABLED=false
OPSPILOT_NOTIFY_DEFAULT_CHANNELS=log
OPSPILOT_NOTIFY_TIMEOUT=10s

# Local dry-run sink. Useful before wiring real external channels.
OPSPILOT_NOTIFY_LOG_ENABLED=true
OPSPILOT_NOTIFY_LOG_NAME=log

# Generic JSON webhook. If secret is set, requests carry X-OpsPilot-Signature.
OPSPILOT_NOTIFY_WEBHOOK_ENABLED=false
OPSPILOT_NOTIFY_WEBHOOK_NAME=webhook
OPSPILOT_NOTIFY_WEBHOOK_URL=
OPSPILOT_NOTIFY_WEBHOOK_SECRET=

# Slack incoming webhook.
OPSPILOT_NOTIFY_SLACK_ENABLED=false
OPSPILOT_NOTIFY_SLACK_NAME=slack
OPSPILOT_NOTIFY_SLACK_WEBHOOK_URL=

# Feishu/Lark custom bot webhook.
OPSPILOT_NOTIFY_FEISHU_ENABLED=false
OPSPILOT_NOTIFY_FEISHU_NAME=feishu
OPSPILOT_NOTIFY_FEISHU_WEBHOOK_URL=
OPSPILOT_NOTIFY_FEISHU_SECRET=

# DingTalk custom robot webhook.
OPSPILOT_NOTIFY_DINGTALK_ENABLED=false
OPSPILOT_NOTIFY_DINGTALK_NAME=dingtalk
OPSPILOT_NOTIFY_DINGTALK_WEBHOOK_URL=
OPSPILOT_NOTIFY_DINGTALK_SECRET=

# opspilot-edge only — dial the broker's edge-bound port (40012, host-mapped to 40012)
OPSPILOT_EDGE_CLOUD_ADDR=localhost:40012
OPSPILOT_EDGE_ACCESS_KEY=
OPSPILOT_EDGE_SECRET_KEY=
OPSPILOT_EDGE_COLLECTOR_MODE=auto
OPSPILOT_EDGE_SCRAPE_CONFIG_FILE=/etc/opspilot-edge/scrape.yaml
OPSPILOT_EDGE_COLLECTOR_INTERVAL=10s
